# PostgreSQL 密码（backend 与 db 共用此变量）
DB_PASSWORD=change-me-to-a-strong-password

# DeepSeek API Key，用于新条目的自动精选评分；留空则关闭评分（精选页将无内容）
DEEPSEEK_API_KEY=

# 管理控制台密码（页面右上角「管理」按钮登录用）；留空则关闭管理功能
ADMIN_PASSWORD=

# Agent 混合召回：默认智谱 embedding-3；留空时仅关键词检索。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT=15
# 请求间隔（秒）及 429 初始冷却（秒）；按账户限额调大。
EMBEDDING_MIN_INTERVAL=1
EMBEDDING_RATE_LIMIT_COOLDOWN=60
SEARCH_INDEX_ENABLED=true

# 精选阈值（0-100，默认 70），可选
# SELECTION_THRESHOLD=70

# 原文获取：优先直连网页 / XML / PDF，Jina Reader 兜底；默认开启
# CONTENT_FETCH_ENABLED=false  # 设为 false 关闭
# JINA_API_KEY=                # 可选；匿名额度有限，配 key 提高限额
CONTENT_FETCH_TIMEOUT=60
CONTENT_MAX_CHARS=100000
