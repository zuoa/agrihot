DATABASE_URL=postgresql+asyncpg://localhost:5432/agrihot
SITE_URL=https://agrihot.com
CORS_ORIGINS=*
INGEST_RATE_LIMIT=60/minute
AGENT_RATE_LIMIT=60/minute
# GLM 语义召回；独立于 DeepSeek 评分。留空时降级为关键词检索。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT=15
# 单进程查询与回填共享：请求至少间隔 1 秒；429 至少冷却 60 秒后退避重试。
EMBEDDING_MIN_INTERVAL=1
EMBEDDING_RATE_LIMIT_COOLDOWN=60
SEARCH_INDEX_ENABLED=true
# 正文获取：整次尝试的总时限（秒）、最多保存字符数。
CONTENT_FETCH_TIMEOUT=60
CONTENT_MAX_CHARS=100000

# 热点专题（时间按 DAILY_TIMEZONE）
SPECIALS_ENABLED=true
SPECIALS_CRON="0 10 * * *"
SPECIALS_MAX_NEW=3
SPECIALS_MAX_UPDATES=10
# 可选：网页检索；留空仍可补充 OpenAlex 学术资料
TAVILY_API_KEY=
